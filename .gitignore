# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets / local env config -- never commit real tokens
.env
.env.*
!.env.example

# AI assistant context file, not part of the public-facing project docs
CLAUDE.md

# Local virtual environments
.venv/
venv/
.venv_test/

# Runtime and generated outputs
output/
tmp/
artifacts/
runtime_outputs/

# Local runtime state
*.log
*.pid
*.sqlite3

# Large generated archives and bundles
*.zip
*.tar.gz
*.h5

# Datasets built by the decision-support prototype (see the
# decision-support-prototype tag). They may still exist in local checkouts.
data/cauren_bridge/
data/cauren_bridge_v4/
data/cauren_civil_nyc/

# KW51 bridge monitoring data (Zenodo 3745914, CC BY-NC-SA 4.0). Downloaded by
# tools/kw51_study.py --download and never committed.
data/kw51/

# Z24 bridge data (KU Leuven). Its terms forbid passing the data to third
# parties, so it must never be committed.
data/z24/

# Hell Bridge Test Arena data (Zenodo 14028239, CC BY 4.0, about 2.5 GB).
data/hbta/

# Vänersborg bridge openings (Zenodo 8300495, CC BY 4.0). Only derived
# features are kept; tools/vanersborg_study.py --fetch streams the raw files.
data/vanersborg/
